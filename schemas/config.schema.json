{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://largentic/schemas/config.schema.json",
  "title": "Largentic V2 Configuration",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 2,
      "description": "Config schema version. Must be 2."
    },
    "profile": {
      "type": "string",
      "enum": ["laravel", "generic"],
      "default": "generic",
      "description": "Framework profile to use."
    },
    "context_optimization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether context optimization is enabled."
        },
        "provider": {
          "type": "string",
          "enum": ["native", "caveman", "fake"],
          "default": "native",
          "description": "Compression provider to use."
        },
        "mode": {
          "type": "string",
          "enum": ["light", "standard", "aggressive"],
          "default": "standard",
          "description": "Optimization aggressiveness."
        },
        "minimum_tokens": {
          "type": "integer",
          "minimum": 0,
          "default": 500,
          "description": "Minimum token count of a file before we attempt to optimize it."
        },
        "minimum_savings_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20,
          "description": "Minimum percentage token reduction required to accept optimized context."
        },
        "maximum_file_size_kb": {
          "type": "integer",
          "minimum": 1,
          "default": 500,
          "description": "Maximum size in KB of a file before we bypass optimization."
        },
        "fail_open": {
          "type": "boolean",
          "default": true,
          "description": "Whether to fall back to the original file if optimization fails."
        },
        "semantic_validation": {
          "type": "boolean",
          "default": true,
          "description": "Whether to perform semantic/validation pipeline check."
        },
        "cache_enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to cache compressed contexts."
        },
        "retain_original_reference": {
          "type": "boolean",
          "default": true,
          "description": "Whether to include a recovery reference/metadata pointing to the original file."
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum repair attempts before the run is failed."
        },
        "plan_approval": {
          "type": "string",
          "enum": ["required", "automatic"],
          "default": "required",
          "description": "Whether a human must approve the plan before implementation."
        },
        "review_approval": {
          "type": "string",
          "enum": ["required", "automatic"],
          "default": "automatic",
          "description": "Whether a human must approve the final review."
        },
        "plan_export_directory": {
          "type": "string",
          "minLength": 1,
          "default": ".largentic/exports",
          "description": "Directory where the plan can be exported as a Markdown file during plan approval. Relative paths resolve from the project working directory."
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planner":     { "$ref": "#/$defs/agentConfig" },
        "implementer": { "$ref": "#/$defs/agentConfig" },
        "tester":      { "$ref": "#/$defs/agentConfig" },
        "reviewer":    { "$ref": "#/$defs/agentConfig" }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_tests": {
          "type": "boolean",
          "default": true
        },
        "require_clean_secrets_scan": {
          "type": "boolean",
          "default": true
        },
        "max_changed_files": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        },
        "test_command": {
          "type": "string",
          "description": "Command to run tests. Overrides profile default."
        },
        "build_command": {
          "type": "string",
          "description": "Command to run build/lint. Overrides profile default."
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_runtime_minutes": {
          "type": "number",
          "minimum": 1,
          "default": 45
        },
        "max_estimated_cost_usd": {
          "type": "number",
          "minimum": 0,
          "default": 10
        }
      }
    },
    "provider": {
      "type": "string",
      "enum": ["codex", "fake"],
      "default": "codex",
      "description": "AI provider to use. Use 'fake' for testing."
    }
  },
  "$defs": {
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["codex", "fake"]
        },
        "reasoning": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "system_prompt_override": {
          "type": "string"
        },
        "context_budget": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum token budget for this agent's context."
        }
      }
    }
  }
}
